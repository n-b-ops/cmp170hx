# URLs resolved 2026-10-30 via GitHub (repo-name + pin/content search).
# The pre-loss URLs are not in any recovered doc; these resolve to the
# vendors' current upstream repos. Pins are canonical in PINS.md (see the
# pin-provenance note there); the four rumdl-tables pins exist only
# locally - fetch them from the restore bundles (recovery/bundles/).
[submodule "vendor/club-170hx"]
	path = vendor/club-170hx
	url = https://github.com/PixelML/club-170hx
[submodule "vendor/cmpunlocker"]
	path = vendor/cmpunlocker
	url = https://github.com/amoghmunikote/cmpunlocker
[submodule "vendor/consensus-cmp170hx"]
	path = vendor/consensus-cmp170hx
	url = https://github.com/Consensus-Protocol/cmp170hx
[submodule "vendor/ninfer-cmp170hx"]
	path = vendor/ninfer-cmp170hx
	url = https://github.com/Ithrial/ninfer-cmp170hx
[submodule "vendor/cmp-170hx-vllm"]
	path = vendor/cmp-170hx-vllm
	url = https://github.com/ahnguyen17/cmp-170hx-vllm
[submodule "vendor/CMP-170hx-64gb-LLM-benchmarks"]
	path = vendor/CMP-170hx-64gb-LLM-benchmarks
	url = https://github.com/Highwayaiexpose/CMP-170hx-64gb-LLM-benchmarks
[submodule "vendor/Qwen3.8-27B-CMP-170HX"]
	path = vendor/Qwen3.8-27B-CMP-170HX
	url = https://github.com/PixelML/Qwen3.8-27B-CMP-170HX
[submodule "vendor/cmp-170hx-docs"]
	path = vendor/cmp-170hx-docs
	url = https://github.com/It-Still-Boots/cmp-170hx-docs
